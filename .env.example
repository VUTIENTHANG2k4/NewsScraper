# MongoDB — Local Docker (dùng cho dev)
# MONGODB_URI=mongodb://mongodb:27017

# MongoDB Atlas — Thay bằng connection string từ Atlas khi deploy production
# Lấy tại: Atlas Dashboard → Connect → Drivers → Copy connection string
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://mongodb:27017

MONGODB_DB=newsdb

# Backend
BACKEND_PORT=8000
CRAWL_INTERVAL_MINUTES=30

# Frontend
# Dev local:
VITE_API_BASE_URL=http://localhost:8000/api/v1
# Production (thay bằng domain/IP thật):
# VITE_API_BASE_URL=https://yourdomain.com/api/v1
