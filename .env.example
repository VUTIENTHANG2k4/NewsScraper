# ── MongoDB ─────────────────────────────────────────────────────────────────────
# Credentials cho MongoDB container (docker-compose).
# Sinh mật khẩu ngẫu nhiên:  python -c "import secrets; print(secrets.token_hex(24))"
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=changeme

# URI kết nối — phải chứa user/pass khớp với 2 biến trên.
# Local Docker:
MONGODB_URI=mongodb://admin:changeme@mongodb:27017/newsdb?authSource=admin

# MongoDB Atlas — Thay bằng connection string từ Atlas khi deploy production
# Lấy tại: Atlas Dashboard → Connect → Drivers → Copy connection string
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

MONGODB_DB=newsdb

# Backend
BACKEND_PORT=8000
CRAWL_INTERVAL_MINUTES=30

# ── Bảo mật ────────────────────────────────────────────────────────────────────
# API Key bảo vệ các endpoint ghi (POST/PATCH/DELETE).
# Dev local: để trống → bỏ qua kiểm tra (tiện phát triển).
# Production: đặt chuỗi ngẫu nhiên ≥32 ký tự, ví dụ:
#   python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=f90a6e703757146c6dcd543f40e6c4aa6b7172a8db689c0883fc4a4378f1d3cd

# Frontend
# Dev local:
VITE_API_BASE_URL=http://localhost:8000/api/v1
# Phải trùng với API_KEY ở trên để frontend gửi đúng key:
VITE_API_KEY=f90a6e703757146c6dcd543f40e6c4aa6b7172a8db689c0883fc4a4378f1d3cd
# Production (thay bằng domain/IP thật):
# VITE_API_BASE_URL=https://yourdomain.com/api/v1
# VITE_API_KEY=<chuỗi giống API_KEY ở trên>
